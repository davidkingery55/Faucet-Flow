# =============================================================================
# FaucetFlow Configuration
# =============================================================================
# Copy this file to .env:  cp .env.example .env
# Then edit .env with your real values.
# =============================================================================

# ---------------------------------------------------------------------------
# Wallet Addresses
# ---------------------------------------------------------------------------
# Comma-separated list of COIN=ADDRESS pairs.
# Supported coin prefixes (case-insensitive): BTC, ETH, DOGE, LTC, BCH, DASH,
#   ZEC, BNB, MATIC, SOL, TRX, USDT, USDC, DAI, XRP, ADA, DOT, LINK, UNI
# You can use any prefix — it's just a label for logging and cooldown tracking.
#
WALLETS=BTC=bc1qyourbitcoinaddresshere,ETH=0xYourEthereumAddressHere,DOGE=DYourDogeAddressHere

# ---------------------------------------------------------------------------
# Browser Settings
# ---------------------------------------------------------------------------
# Which browser to automate: "chrome" or "edge"
BROWSER=chrome

# Absolute path to your browser's user data directory.
# This is where Chrome/Edge stores your bookmarks, extensions, saved passwords,
# and wallet extensions (MetaMask, etc.). Using your real profile means faucet
# sites that require login will already be authenticated.
#
# Platform-specific default locations:
#
#   Linux:
#     Chrome:  /home/YOURUSER/.config/google-chrome
#     Edge:    /home/YOURUSER/.config/microsoft-edge
#
#   macOS:
#     Chrome:  /Users/YOURUSER/Library/Application Support/Google/Chrome
#     Edge:    /Users/YOURUSER/Library/Application Support/Microsoft Edge
#
#   Windows:
#     Chrome:  C:\Users\YOURUSER\AppData\Local\Google\Chrome\User Data
#     Edge:    C:\Users\YOURUSER\AppData\Local\Microsoft\Edge\User Data
#
# Leave empty to use a fresh temporary profile (no saved logins).
BROWSER_PROFILE_PATH=

# Optional: specific profile folder within the user data directory.
# Chrome profiles are named "Default", "Profile 1", "Profile 2", etc.
# Edge profiles follow the same convention.
# Leave empty to use the default profile.
BROWSER_PROFILE_DIRECTORY=Default

# Run browser in headless mode? "true" or "false"
# Headless mode runs without a visible window (useful for servers).
# Some faucet sites detect and block headless browsers.
HEADLESS=false

# ---------------------------------------------------------------------------
# Claim Settings
# ---------------------------------------------------------------------------
# Cooldown in hours between claims for the same faucet+wallet pair.
# Most faucets enforce a 24-hour timer server-side anyway.
COOLDOWN_HOURS=24

# Timeout in seconds for page loads
PAGE_LOAD_TIMEOUT=30

# Timeout in seconds for individual element lookups
ELEMENT_TIMEOUT=10
