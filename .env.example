# =============================================================================
# FaucetFlow Configuration
# =============================================================================
# Copy this file to .env:  cp .env.example .env
# Then edit .env with your real values.
# =============================================================================

# ---------------------------------------------------------------------------
# Wallet Addresses
# ---------------------------------------------------------------------------
# Comma-separated list of wallet addresses. Order matters — each address is
# referenced by its 0-based index. faucets.json can restrict which wallet
# indexes a faucet claims to via the "wallet_indexes" field.
#
WALLET_ADDRESSES=0xWallet1,0xWallet2

# ---------------------------------------------------------------------------
# Threading
# ---------------------------------------------------------------------------
# Number of concurrent threads for processing faucets. Keep at 1 unless you
# have multiple browser profiles configured.
MAX_THREADS=1

# ---------------------------------------------------------------------------
# Browser Settings
# ---------------------------------------------------------------------------
# Run browser in headless mode? "true" or "false"
# Headless mode runs without a visible window. Some faucet sites detect and
# block headless browsers.
HEADLESS=false

# Which browser to use: "chrome" or "edge"
BROWSER=edge

# Path to the browser's WebDriver executable (chromedriver / msedgedriver).
# Download the driver manually from:
#   Chrome:  https://chromedriver.chromium.org/
#   Edge:    https://developer.microsoft.com/en-us/microsoft-edge/tools/webdriver/
# Match the driver version to your installed browser version.
DRIVER_PATH=./msedgedriver.exe

# Absolute path to your browser's user data directory.
# This is where Chrome/Edge stores your bookmarks, extensions, saved
# passwords, and wallet extensions (MetaMask, etc.). Using your real profile
# means faucet sites that require login will already be authenticated.
#
# Platform-specific default locations:
#   Chrome:
#     Linux:   /home/YOURUSER/.config/google-chrome
#     macOS:   /Users/YOURUSER/Library/Application Support/Google/Chrome
#     Windows: C:\Users\YOURUSER\AppData\Local\Google\Chrome\User Data
#   Edge:
#     Linux:   /home/YOURUSER/.config/microsoft-edge
#     macOS:   /Users/YOURUSER/Library/Application Support/Microsoft Edge
#     Windows: C:\Users\YOURUSER\AppData\Local\Microsoft\Edge\User Data
#
# Leave empty to use a fresh temporary profile (no saved logins).
BROWSER_DATA_DIR=C:\Users\<USERNAME>\AppData\Local\Microsoft\Edge\User Data

# Specific profile folder within the user data directory.
# Chrome profiles are named "Default", "Profile 1", "Profile 2", etc.
# Edge profiles follow the same convention.
BROWSER_PROFILE=Default

# ---------------------------------------------------------------------------
# Retry Settings
# ---------------------------------------------------------------------------
# Number of retries per faucet claim on failure. 0 means no retries.
RETRY_COUNT=0

# Base backoff in seconds between retries. Multiplied by the attempt number
# for exponential backoff (attempt 1: 5s, attempt 2: 10s, attempt 3: 15s...).
RETRY_BACKOFF_SECONDS=5

# ---------------------------------------------------------------------------
# Timeouts
# ---------------------------------------------------------------------------
# Maximum seconds to wait for a success or error message element to appear
# after submitting a claim.
DEFAULT_WAIT_TIMEOUT=60

# ---------------------------------------------------------------------------
# Ad/Popup Dismissal
# ---------------------------------------------------------------------------
# Number of attempts to close popup ads. Increase if faucet sites have
# multiple layered popups.
CLOSE_AD_ATTEMPTS=1

# Delay in seconds between ad-close attempts.
CLOSE_AD_RETRY_DELAY=5
